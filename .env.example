# ============================================================
#  HPU Chatbot — biến môi trường
#  Copy file này thành .env rồi điền giá trị thật.
# ============================================================

# --- Database (Sprint 0) ---
DATABASE_URL=postgresql://hpu:doi_mat_khau_nay@db:5432/hpu_chatbot
DB_PASSWORD=doi_mat_khau_nay

# --- Auth.js / NextAuth v5 (Sprint 1) ---
AUTH_SECRET=doi_secret_nay              # openssl rand -base64 32
NEXTAUTH_URL=https://chat.hpu.edu.vn    # local dev: http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=doi_client_id
GOOGLE_CLIENT_SECRET=doi_client_secret
ALLOWED_HD=hpu.edu.vn
ADMIN_EMAILS=trungth@hpu.edu.vn
STUDENT_EMAIL_REGEX=^[a-z]{2}\d{5,}@

# --- Gemini (Sprint 3+) ---
GEMINI_API_KEY=doi_gemini_key
GEMINI_MODEL=gemini-2.0-flash           # dùng bản Flash mới nhất khi triển khai
EMBEDDING_MODEL=text-embedding-004

# --- Worker nạp tài liệu từ Google Drive (Sprint 3) ---
# Service Account JSON key -> mã hóa base64:  base64 -w0 sa-key.json
# Nhớ SHARE các thư mục tài liệu cho email của Service Account (quyền Viewer).
GOOGLE_SA_KEY_BASE64=doi_base64_key_service_account
# URL worker đồng bộ (mặc định tên service trong compose)
INGEST_URL=http://ingest:8787
CHUNK_TARGET_CHARS=1600
CHUNK_OVERLAP_CHARS=240

# --- RAG (dùng từ Sprint 4) ---
# RETRIEVAL_TOP_K=6
# SIMILARITY_THRESHOLD=0.55
# Giới hạn tần suất chat mỗi người dùng
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000

# --- Zalo OA (Sprint 9) ---
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=        # OA Secret Key (dùng xác thực chữ ký webhook)
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_ALLOWED_PRODUCTS=pmt-ems,tuyen-sinh
ZALO_RATE_LIMIT=15
